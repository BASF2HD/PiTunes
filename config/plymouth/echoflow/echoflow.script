Window.SetBackgroundTopColor(0.015, 0.016, 0.024);
Window.SetBackgroundBottomColor(0.015, 0.016, 0.024);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
center_x = screen_w / 2;
center_y = screen_h / 2;

logo_image = Image.Text("EF", 1, 1, 1);
logo_sprite = Sprite(logo_image);
logo_sprite.SetX(center_x - logo_image.GetWidth() / 2);
logo_sprite.SetY(center_y - 92);

title_image = Image.Text("EchoFlow", 0.92, 0.94, 1);
title_sprite = Sprite(title_image);
title_sprite.SetX(center_x - title_image.GetWidth() / 2);
title_sprite.SetY(center_y - 18);

spinner_index = 0;
spinner_image = Image.Text("|", 0.92, 0.94, 1);
spinner_sprite = Sprite(spinner_image);
spinner_sprite.SetX(center_x - spinner_image.GetWidth() / 2);
spinner_sprite.SetY(center_y + 42);

progress_image = Image.Text("Starting", 0.58, 0.61, 0.72);
progress_sprite = Sprite(progress_image);
progress_sprite.SetX(center_x - progress_image.GetWidth() / 2);
progress_sprite.SetY(center_y + 74);

fun refresh_callback() {
  spinner_index = (spinner_index + 1) % 4;
  spinner_frame = "|";
  if (spinner_index == 1) spinner_frame = "/";
  if (spinner_index == 2) spinner_frame = "-";
  if (spinner_index == 3) spinner_frame = "\\";
  spinner_image = Image.Text(spinner_frame, 0.92, 0.94, 1);
  spinner_sprite.SetImage(spinner_image);
  spinner_sprite.SetX(center_x - spinner_image.GetWidth() / 2);

  progress = Math.Int(Plymouth.GetBootProgress() * 100);
  if (progress < 0) progress = 0;
  if (progress > 100) progress = 100;
  progress_text = "Loading " + progress + "%";
  progress_image = Image.Text(progress_text, 0.58, 0.61, 0.72);
  progress_sprite.SetImage(progress_image);
  progress_sprite.SetX(center_x - progress_image.GetWidth() / 2);
}

Plymouth.SetRefreshFunction(refresh_callback);

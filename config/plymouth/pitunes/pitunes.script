Window.SetBackgroundTopColor(0.388, 0.388, 0.400);
Window.SetBackgroundBottomColor(0.388, 0.388, 0.400);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
center_x = screen_w / 2;
center_y = screen_h / 2;

logo_image = Image("pitunes-logo.png");
logo_sprite = Sprite(logo_image);
logo_sprite.SetX(center_x - logo_image.GetWidth() / 2);
logo_y = center_y - logo_image.GetHeight() / 2 - 12;
logo_sprite.SetY(logo_y);
logo_sprite.SetZ(100);

progress_track_image = Image("progress-track.png");
progress_track_sprite = Sprite(progress_track_image);
progress_x = center_x - progress_track_image.GetWidth() / 2;
progress_y = logo_y + logo_image.GetHeight() + 18;
progress_track_sprite.SetX(progress_x);
progress_track_sprite.SetY(progress_y);
progress_track_sprite.SetZ(90);

progress_fill_image = Image("progress-fill.png");
progress_fill_sprite = Sprite(progress_fill_image);
progress_fill_sprite.SetX(progress_x);
progress_fill_sprite.SetY(progress_y);
progress_fill_sprite.SetZ(95);
progress_fill_sprite.SetClip(progress_x, progress_y, 0, progress_fill_image.GetHeight());
shown_progress = 0;
refresh_ticks = 0;

fun show_progress(progress) {
  if (progress < shown_progress) progress = shown_progress;
  if (progress < 0) progress = 0;
  if (progress > 1) progress = 1;
  shown_progress = progress;
  progress_width = Math.Int(progress_fill_image.GetWidth() * progress);
  progress_fill_sprite.SetClip(progress_x, progress_y, progress_width, progress_fill_image.GetHeight());
}

fun progress_callback(time, progress) {
  show_progress(progress);
}

fun refresh_callback() {
  refresh_ticks = refresh_ticks + 1;
  fallback_progress = refresh_ticks / 1800;
  if (fallback_progress > 0.92) fallback_progress = 0.92;
  show_progress(fallback_progress);
}

Plymouth.SetBootProgressFunction(progress_callback);
Plymouth.SetRefreshFunction(refresh_callback);

[Unit]
Description=PiTunes signed A/B system update
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/pitunes/system-update.json
Conflicts=pitunes-update.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/pitunes/scripts/pitunes-system-update.sh
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target

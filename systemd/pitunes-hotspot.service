[Unit]
Description=PiTunes WiFi hotspot when no network (Moode-style)
Wants=NetworkManager.service
After=NetworkManager.service
Before=pitunes-api.service pitunes-display.service
Conflicts=shutdown.target
DefaultDependencies=yes

[Service]
Type=simple
ExecStart=/opt/pitunes/scripts/wifi-hotspot.sh watch
ExecStop=/opt/pitunes/scripts/wifi-hotspot.sh stop
TimeoutStartSec=180
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

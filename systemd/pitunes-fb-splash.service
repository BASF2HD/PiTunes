[Unit]
Description=PiTunes framebuffer boot splash
DefaultDependencies=no
After=local-fs.target
Before=graphical.target lightdm.service pitunes-display.service
ConditionPathExists=/dev/fb0

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/pitunes/scripts/pitunes-fb-splash.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=sysinit.target

[Unit]
Description=EchoFlow WiFi hotspot when no network (Moode-style)
Wants=NetworkManager.service
After=NetworkManager.service
Before=echoflow-api.service echoflow-display.service
Conflicts=shutdown.target
DefaultDependencies=yes

[Service]
Type=simple
ExecStart=/opt/echoflow/scripts/wifi-hotspot.sh watch
ExecStop=/opt/echoflow/scripts/wifi-hotspot.sh stop
TimeoutStartSec=180
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

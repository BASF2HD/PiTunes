# Pinned Raspberry Pi OS Lite base images (Bookworm).
# Update these when rebasing to a newer monthly release.
# See: https://www.raspberrypi.com/software/operating-systems/

RPIOS_RELEASE="2024-11-19"

RPIOS_LITE_ARMHF_URL="https://downloads.raspberrypi.com/raspios_lite_armhf/images/raspios_lite_armhf-${RPIOS_RELEASE}/${RPIOS_RELEASE}-raspios-bookworm-armhf-lite.img.xz"
RPIOS_LITE_ARMHF_NAME="${RPIOS_RELEASE}-raspios-bookworm-armhf-lite.img"

RPIOS_LITE_ARM64_URL="https://downloads.raspberrypi.com/raspios_lite_arm64/images/raspios_lite_arm64-${RPIOS_RELEASE}/${RPIOS_RELEASE}-raspios-bookworm-arm64-lite.img.xz"
RPIOS_LITE_ARM64_NAME="${RPIOS_RELEASE}-raspios-bookworm-arm64-lite.img"

# Default output asset name (without .xz)
IMAGE_BASENAME="PiTunes"
